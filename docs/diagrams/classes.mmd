---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 46
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
classDiagram
    direction LR
    class RawDecoder {
        <<interface>>
        decode(bytes, name) RawImage
    }
    class BadPixelDetector {
        <<interface>>
        detect(image) BadPixelCandidates
    }
    class DngEncoder {
        <<interface>>
        encode(image, options) bytes
    }
    class TiffEncoder {
        <<interface>>
        encode(image, options) bytes
    }
    class FileStore {
        <<interface>>
        read(path) bytes
        write(path, bytes)
        exists(path) bool
    }
    class Converter {
        convert(jobs, progress) results
        convertFile(input, output) result
        repair(image) count
        cancel()
        defectMap() DefectMap
    }
    class DefectMap {
        addShot(camera, candidates, scene)
        confirmed(camera) pixels
        read(stream)
        write(stream)
    }
    Converter o-- RawDecoder : injected
    Converter o-- BadPixelDetector : injected
    Converter o-- DngEncoder : injected
    Converter o-- TiffEncoder : injected
    Converter o-- FileStore : injected
    Converter *-- DefectMap : owns

    style Converter fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    style RawDecoder fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    style BadPixelDetector fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    style DngEncoder fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    style TiffEncoder fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    style FileStore fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    style DefectMap fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
