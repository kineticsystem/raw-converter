---
config:
  theme: base
  fontFamily: "Arial, Helvetica, sans-serif"
  flowchart:
    curve: basis
    padding: 12
    nodeSpacing: 22
    rankSpacing: 32
    subGraphTitleMargin:
      top: 4
      bottom: 10
  class:
    padding: 10
  themeVariables:
    lineColor: "#94a3b8"
    textColor: "#64748b"
    primaryColor: "#f1f5f9"
    primaryBorderColor: "#64748b"
    primaryTextColor: "#0f172a"
    secondaryColor: "#f1f5f9"
    secondaryBorderColor: "#64748b"
    secondaryTextColor: "#0f172a"
    tertiaryColor: "#f1f5f9"
    tertiaryBorderColor: "#64748b"
    tertiaryTextColor: "#0f172a"
    mainBkg: "#f1f5f9"
    nodeBorder: "#64748b"
    nodeTextColor: "#0f172a"
    classText: "#0f172a"
    clusterBkg: "transparent"
    clusterBorder: "#94a3b8"
    titleColor: "#64748b"
    edgeLabelBackground: "#ffffff"
  themeCSS: >
    svg, .label, .nodeLabel, .edgeLabel, foreignObject div { font-family: Arial, Helvetica, sans-serif; }
    .node rect, .node polygon, .node path {
      filter: drop-shadow(0 3px 6px rgba(15, 23, 42, 0.18));
    }
    .node rect { rx: 14px; ry: 14px; }
    .cluster rect { rx: 18px; ry: 18px; }
    .edgeLabel, .edgeLabel p, .edgeLabel span {
      background: #ffffff; color: #475569; border-radius: 999px;
    }
    .edgeLabel p { padding: 3px 10px; }
    .uml .nodeLabel { display: block; text-align: left; white-space: nowrap; }
    .uml .nodeLabel hr { border: none; border-top: 1.5px solid currentColor; opacity: 0.45; margin: 7px -12px; }
    .uml .nodeLabel .name { display: block; text-align: center; }
    .labelBkg { background: transparent !important; fill: none !important; }
---
flowchart LR
    Converter["<span class='name'><b>Converter</b></span><hr>convert(jobs, progress) : results<br>convertFile(input, output) : result<br>repair(image) : count<br>cancel()<br>defectMap() : DefectMap"]:::core
    RawDecoder["<span class='name'>«interface»<br><b>RawDecoder</b></span><hr>decode(bytes, name) : RawImage"]:::iface
    BadPixelDetector["<span class='name'>«interface»<br><b>BadPixelDetector</b></span><hr>detect(image) : BadPixelCandidates"]:::iface
    DngEncoder["<span class='name'>«interface»<br><b>DngEncoder</b></span><hr>encode(image, options) : bytes"]:::iface
    TiffEncoder["<span class='name'>«interface»<br><b>TiffEncoder</b></span><hr>encode(image, options) : bytes"]:::iface
    FileStore["<span class='name'>«interface»<br><b>FileStore</b></span><hr>read(path) : bytes<br>write(path, bytes)<br>exists(path) : bool"]:::iface
    DefectMap["<span class='name'><b>DefectMap</b></span><hr>addShot(camera, candidates, scene)<br>confirmed(camera) : pixels<br>read(stream)<br>write(stream)"]:::data
    Converter -- injected --> RawDecoder
    Converter -- injected --> BadPixelDetector
    Converter -- injected --> DngEncoder
    Converter -- injected --> TiffEncoder
    Converter -- injected --> FileStore
    Converter -- owns --> DefectMap
    classDef core fill:#7c3aed,stroke:#5b21b6,stroke-width:2px,color:#ffffff
    classDef iface fill:#ccfbf1,stroke:#0d9488,stroke-width:2px,color:#134e4a
    classDef data fill:#dbeafe,stroke:#2563eb,stroke-width:2px,color:#1e3a8a
    class Converter,RawDecoder,BadPixelDetector,DngEncoder,TiffEncoder,FileStore,DefectMap uml
