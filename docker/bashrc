# Interactive shell setup for the developer user, sourced from ~/.bashrc.
#
# Only what genuinely needs a shell belongs here. Variables are set with ENV in
# the Dockerfile instead, so that they apply to non-interactive commands too,
# such as `docker exec <container-name> build.sh`.

# Short names for the scripts in ./bin, which are on the PATH. These have to be
# aliases rather than symlinks: `test` is a bash builtin, and builtins win over
# a PATH lookup, whereas aliases are expanded before either.
alias build='build.sh'
alias test='test.sh'
alias samples='fetch-samples.sh'
