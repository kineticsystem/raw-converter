@PACKAGE_INIT@

# The library links LibRaw and Little CMS privately; a static build still
# needs them found.
include(CMakeFindDependencyMacro)
find_dependency(Threads)
find_dependency(PkgConfig)
pkg_check_modules(LIBRAW REQUIRED IMPORTED_TARGET libraw_r)
pkg_check_modules(LCMS2 REQUIRED IMPORTED_TARGET lcms2)

include("${CMAKE_CURRENT_LIST_DIR}/rawconvTargets.cmake")
check_required_components(rawconv)
